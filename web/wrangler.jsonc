{
  "name": "shizudai-pocket-local",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "preview": {
      "name": "shizudai-pocket-preview",
      "d1_databases": [{
        "binding": "DB",
        "database_name": "shizudai-pocket-preview",
        "database_id": "REPLACE_WITH_PREVIEW_D1_ID",
        "migrations_dir": "migrations"
      }],
      "triggers": {"crons": ["0 * * * *"]}
    },
    "production": {
      "name": "shizudai-pocket",
      "d1_databases": [{
        "binding": "DB",
        "database_name": "shizudai-pocket-production",
        "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
        "migrations_dir": "migrations"
      }],
      "triggers": {"crons": ["0 * * * *"]}
    }
  }
}
